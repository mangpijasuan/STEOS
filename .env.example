# Runtime connection: the restricted app role. Row-level security applies to it.
DATABASE_URL=postgres://siamsil_app:dev_app_pw@localhost:5432/siamsil
# Migrations and seeding only: the table owner. Never use this at runtime.
DATABASE_OWNER_URL=postgres://siamsil_owner:dev_owner_pw@localhost:5432/siamsil
# Name of the restricted role, granted privileges by the migration.
APP_DB_ROLE=siamsil_app
# Public base URL, used in login links.
APP_URL=http://localhost:3000
# Production email requires a verified Resend sender and an HTTPS APP_URL.
RESEND_API_KEY=
LOGIN_FROM_EMAIL=
# Optional compatible settings for existing Sprint 6 deployments.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=orders@example.com
# Optional Slack-compatible webhook for operational alerts.
ALERT_WEBHOOK_URL=
# Staging only: ask search engines not to index this site (robots.txt disallows everything).
# ROBOTS_NOINDEX=true
# LOG_LEVEL=info
# Optional trusted single-IP header. Your ingress must overwrite it on every request.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# Seed data
SEED_OWNER_EMAIL=owner@example.com

# Payments. Use "fake" for local development with no Stripe account, "stripe" for sandbox or live.
PAYMENTS_PROVIDER=fake
# Stripe test keys (never commit real values). The webhook secret comes from the Connect webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Secret used to derive customers' private order links. Use a long random value.
ORDER_TOKEN_SECRET=
# Shared secret for the scheduler that calls /api/internal/expire-orders every minute.
CRON_SECRET=
# Optional override for worker:orders, such as a local app listener. Defaults to APP_URL.
# ORDER_WORKER_URL=http://127.0.0.1:3000
